# Copy to .env and fill in. Never commit real secrets.

# Frontend (Vite)
VITE_API_URL=
# Leave empty in development so the Vite proxy is used.
# Production example: https://play.example.com

# Backend (ASP.NET Core) — also set via environment / systemd / compose
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5080

# SqlServer | Sqlite | Npgsql
Database__Provider=SqlServer
ConnectionStrings__Default=Server=.\\SQLEXPRESS;Database=Cheslax;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True

Cors__Origins=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated. Production must list the public HTTPS origin only.
# Cors__Origins=https://play.example.com
