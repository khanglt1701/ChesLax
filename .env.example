# Monorepo convenience file. Independent repos use backend/.env.example and frontend/.env.example.
# Copy to .env. Never commit real secrets.

# Frontend (Vite). Leave empty so the Vite proxy is used.
VITE_API_URL=

# Backend
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5080
Database__Provider=Npgsql
Database__ApplyMigrations=true
ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=cheslax;Username=cheslax;Password=cheslax
Cors__Origins=http://localhost:5173,http://127.0.0.1:5173
