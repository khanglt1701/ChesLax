# Local play and AI do not need Firebase.
# Online rooms need a Firebase Realtime Database project on the Spark plan.
# VITE_* values are embedded in the public JavaScript bundle at build time.
# They identify the Firebase project. Access control belongs in database.rules.json.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
