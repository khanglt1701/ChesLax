{
  "name": "cheslax",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c teal,orange \"npm run dev -w frontend\" \"dotnet watch --project backend/src/Cheslax.Api/Cheslax.Api.csproj --non-interactive\"",
    "dev:client": "npm run dev -w frontend",
    "dev:api": "dotnet watch --project backend/src/Cheslax.Api/Cheslax.Api.csproj --non-interactive",
    "dev:server": "tsx watch server/src/index.ts",
    "start:server": "tsx server/src/index.ts",
    "build": "npm run build -w frontend",
    "build:api": "dotnet build backend/Cheslax.slnx -c Release",
    "test:api": "dotnet test backend/Cheslax.slnx",
    "preview": "npm run preview -w frontend"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.5",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
