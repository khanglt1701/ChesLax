# Copy to .env. Never commit real secrets.
#
# VITE_* values are embedded in the public JavaScript bundle at build time.
# Do not put database passwords, JWT secrets, or cookie keys here.

# Leave empty to use same-origin /api, /hubs, /health (Vite proxy in dev, Nginx in prod).
VITE_API_URL=

# Optional: override the Vite dev-server proxy target (default http://127.0.0.1:5080).
# VITE_DEV_API_PROXY=http://127.0.0.1:5080

# Docker Nginx upstream (frontend/docker-compose.yml). Default is the backend Compose service.
# API_UPSTREAM=api:8080
# API_UPSTREAM=host.docker.internal:5080
