// Production CI/CD for ChesLax SPA (Docker Compose on the Jenkins agent).
//
// Jenkins job:
//   Pipeline from SCM → Script Path: Jenkinsfile   (ChesLax_FE)
//   or Script Path: frontend/Jenkinsfile           (monorepo)
// Agent: Linux with Docker Engine + Compose v2
// Deploy backend first so network cheslax_cheslax_internal exists.
// Secrets: optional File credential `cheslax-fe-env`, or ENV_FILE on the agent.
// Leave VITE_API_URL empty for same-origin /api via Nginx.
//
// Helper methods at the bottom of a Declarative Jenkinsfile are not pipeline DSL
// steps — keep all Groovy inline so CPS sandbox can run it.

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    booleanParam(name: 'RUN_CHECKS', defaultValue: true, description: 'npm ci + typecheck before building the image')
    booleanParam(name: 'DEPLOY', defaultValue: true, description: 'Deploy to production (main only unless FORCE_DEPLOY)')
    booleanParam(name: 'FORCE_DEPLOY', defaultValue: false, description: 'Allow deploy from a non-main branch')
    string(name: 'ENV_FILE', defaultValue: '/etc/cheslax/frontend.env', description: 'Optional production env file on the agent')
    string(name: 'VITE_API_URL', defaultValue: '', description: 'Leave empty for same-origin /api and /hubs')
  }

  environment {
    IMAGE = 'cheslax-web'
    HEALTH_URL = 'http://127.0.0.1:8088/'
    API_HEALTH_URL = 'http://127.0.0.1:8088/health'
    BACKEND_NETWORK = 'cheslax_cheslax_internal'
    VITE_API_URL = "${params.VITE_API_URL}"
  }

  stages {
    stage('Prepare') {
      steps {
        script {
          env.APP_DIR = fileExists('docker-compose.yml') ? '.' : 'frontend'
          if (!fileExists("${env.APP_DIR}/docker-compose.yml") || !fileExists("${env.APP_DIR}/Dockerfile")) {
            error 'Cannot find frontend docker-compose.yml / Dockerfile.'
          }

          def dest = "${env.WORKSPACE}/.jenkins.env"
          def bound = false
          try {
            withCredentials([file(credentialsId: 'cheslax-fe-env', variable: 'SECRET_ENV')]) {
              sh 'cp "$SECRET_ENV" "$WORKSPACE/.jenkins.env" && chmod 600 "$WORKSPACE/.jenkins.env"'
            }
            env.ENV_FILE = dest
            bound = true
          } catch (ignored) {
            bound = false
          }
          if (!bound) {
            env.ENV_FILE = fileExists(params.ENV_FILE) ? params.ENV_FILE : ''
          }

          def branch = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
          env.SHOULD_DEPLOY = (params.DEPLOY && (params.FORCE_DEPLOY || branch == 'main' || branch.endsWith('/main'))) ? 'true' : 'false'
          echo "Branch=${branch} SHOULD_DEPLOY=${env.SHOULD_DEPLOY} ENV_FILE=${env.ENV_FILE}"
        }
      }
    }

    stage('Typecheck') {
      when { expression { return params.RUN_CHECKS } }
      steps {
        dir(env.APP_DIR) {
          sh '''
            set -eu
            HOST_WORKSPACE="/var/lib/docker/volumes/jenkins_home/_data/workspace/${JOB_NAME}"
            docker run --rm \
              -v "$HOST_WORKSPACE":/app -w /app \
              node:20-alpine \
              sh -c "npm ci && npm run typecheck && npm test"
          '''
        }
      }
    }

    stage('Build image') {
      when { expression { return env.SHOULD_DEPLOY == 'true' } }
      steps {
        dir(env.APP_DIR) {
          sh '''
            set -eu
            docker image inspect "${IMAGE}:latest" >/dev/null 2>&1 \
              && docker tag "${IMAGE}:latest" "${IMAGE}:previous" || true
            if [ -n "${ENV_FILE:-}" ] && [ -f "$ENV_FILE" ]; then
              docker compose --env-file "$ENV_FILE" build web
            else
              docker compose build web
            fi
            docker tag "${IMAGE}:latest" "${IMAGE}:${BUILD_NUMBER}"
          '''
        }
      }
    }

    stage('Deploy') {
      when { expression { return env.SHOULD_DEPLOY == 'true' } }
      steps {
        dir(env.APP_DIR) {
          script { env.CHESLAX_DEPLOYED = 'true' }
          sh '''
            set -eu
            if ! docker network inspect "$BACKEND_NETWORK" >/dev/null 2>&1; then
              echo "Network $BACKEND_NETWORK is missing. Deploy ChesLax_BE first."
              exit 1
            fi
            if [ -n "${ENV_FILE:-}" ] && [ -f "$ENV_FILE" ]; then
              docker compose --env-file "$ENV_FILE" up -d
            else
              docker compose up -d
            fi
          '''
        }
      }
    }

    stage('Health') {
      when { expression { return env.SHOULD_DEPLOY == 'true' } }
      steps {
        dir(env.APP_DIR) {
          sh '''
            set -eu
            compose() {
              if [ -n "${ENV_FILE:-}" ] && [ -f "$ENV_FILE" ]; then
                docker compose --env-file "$ENV_FILE" "$@"
              else
                docker compose "$@"
              fi
            }
            echo "Checking the SPA inside the web container (host bind is 127.0.0.1:8088)"
            for i in $(seq 1 20); do
              if compose exec -T web wget -qO- -T 5 http://127.0.0.1/ >/dev/null; then
                echo "SPA healthy"
                if compose exec -T web wget -qO- -T 5 http://127.0.0.1/health >/dev/null; then
                  echo "API proxy healthy"
                else
                  echo "SPA up; /health proxy not ready yet"
                fi
                exit 0
              fi
              sleep 3
            done
            echo "Frontend health check failed"
            compose ps || true
            compose logs --tail 80 web || true
            exit 1
          '''
        }
      }
    }
  }

  post {
    failure {
      script {
        if (env.CHESLAX_DEPLOYED == 'true') {
          dir(env.APP_DIR ?: '.') {
            sh '''
              if docker image inspect "${IMAGE}:previous" >/dev/null 2>&1; then
                echo "Rolling back to ${IMAGE}:previous"
                docker tag "${IMAGE}:previous" "${IMAGE}:latest"
                docker compose up -d web || true
              fi
            '''
          }
        }
      }
    }
    always {
      sh 'rm -f "$WORKSPACE/.jenkins.env"'
    }
    success {
      echo "Production SPA: ${env.HEALTH_URL}"
    }
  }
}
